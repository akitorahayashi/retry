{
  "name": "retry",
  "version": "1.1.0",
  "description": "TypeScript GitHub Action for command retry execution",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "check": "biome check . && pnpm run typecheck",
    "fix": "biome check --write .",
    "clean": "rm -rf .tmp coverage node_modules dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "package": "ncc build src/index.ts -o dist --license licenses.txt"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.3",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^3.2.4",
    "js-yaml": "^4.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
